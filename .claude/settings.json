{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/query-schema-check.fish",
            "statusMessage": "🔍 Verifying database health before subagent starts..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ci-check.fish",
            "statusMessage": "🔄 Checking GitHub CI status after push..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/query-symbol-check.fish",
            "statusMessage": "🔍 Verifying ground truth was queried before coding..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/verify-rust.fish",
            "statusMessage": "🦀 Verifying Rust code compiles and graph is updated..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/splice-cycles-check.fish",
            "statusMessage": "🔄 Checking for call graph cycles after refactoring..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/stub-check.fish",
            "statusMessage": "🚫 Checking for stub code (panic! in non-test)..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/wiring-check.fish",
            "statusMessage": "🔌 Verifying wiring (dead modules, sqlitegraph integration, debug cleanup)..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/security-check.fish",
            "statusMessage": "🛡️ Checking for security issues in new code..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/logseq-session-hook.fish",
            "statusMessage": "📓 Logging session to Logseq..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(cargo clean:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo update:*)",
      "Bash(cargo init:*)",
      "Bash(cargo add:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo package:*)",
      "Bash(cargo search:*)",
      "Bash(cargo login:*)",
      "Bash(cargo info:*)",
      "Bash(cargo fetch:*)",
      "Bash(magellan:*)",
      "Bash(llmgrep:*)",
      "Bash(mirage:*)",
      "Bash(splice:*)",
      "Bash(sqlite3:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(rustc:*)",
      "Bash(git init:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git log:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git rm:*)",
      "Bash(git stash:*)",
      "Bash(git ls-tree:*)",
      "Bash(git worktree:*)",
      "Bash(git check-ignore:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth:*)",
      "Bash(gh pr:*)",
      "Bash(gh release create:*)",
      "Bash(gh run list:*)",
      "Bash(./scripts/*)",
      "Bash(.claude/scripts/*)",
      "Bash(chmod +x *)",
      "Bash(mkdir -p *)",
      "Bash(cp *)",
      "Bash(rm -rf .magellan/*.db*)",
      "Bash(pkill -f \"magellan watch\")"
    ]
  },
  "skills": {
    "auto_load": [
      "code-intelligence-ecosystem",
      "code-intelligence-workflow",
      "graph-query",
      "wiring-check",
      "repo-hygiene"
    ]
  }
}
